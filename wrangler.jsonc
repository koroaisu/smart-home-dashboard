{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sekhmet-home-dashboard",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./cloudflare-dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "build": {
    "command": "node scripts/build-cloudflare.mjs"
  },
  "observability": {
    "enabled": false
  }
}
