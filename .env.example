# Configure these as production runtime secrets. Do not put real values in Git.
CALENDAR_PUBLIC_ORIGIN=https://your-dashboard.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDAR_COOKIE_KEY=

# Cloudflare Access settings (no real values in Git)
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=
CALENDAR_OWNER_EMAIL=

# SwitchBot v1.1 server-side credentials (never expose to browser assets)
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
# JSON: {"ceiling":["12_HEX_DIGIT_DEVICE_ID", "ANOTHER_DEVICE_ID"]}
SWITCHBOT_DEVICE_MAP=
