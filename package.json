{
  "name": "smart-home-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-figma-preview.mjs && node server.mjs",
    "start": "node scripts/build-figma-preview.mjs && node server.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "wrangler dev",
    "check:cloudflare": "wrangler deploy --dry-run --outdir cloudflare-dist/bundle",
    "deploy:cloudflare": "wrangler deploy",
    "build": "node scripts/build-figma-preview.mjs"
  },
  "dependencies": {
    "jose": "6.2.17"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  },
  "description": "iPad向けのピクセルアート・スマートホームダッシュボード"
}
